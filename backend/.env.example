PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/headshot-haven

# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Where the frontend runs (comma-separate several origins). Used for CORS and the OAuth redirect.
FRONTEND_URL=http://localhost:3000

# Optional: Google sign-in. Leave blank to disable; the button hides itself automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
